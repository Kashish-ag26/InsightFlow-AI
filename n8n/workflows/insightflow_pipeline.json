{
  "name": "InsightFlow Autonomous AI News Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "name": "Cron Trigger (Every 2 Hours)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/v1/news/harvest",
        "options": {}
      },
      "name": "Trigger News Collector Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/v1/knowledge/query",
        "method": "POST",
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "query",
              "value": "Summarize top stories"
            }
          ]
        }
      },
      "name": "Gemini RAG Synthesis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Cron Trigger (Every 2 Hours)": {
      "main": [
        [
          {
            "node": "Trigger News Collector Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger News Collector Agent": {
      "main": [
        [
          {
            "node": "Gemini RAG Synthesis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
